# 网页截图PDF工具环境变量配置
# 复制此文件为 .env 并根据需要修改

# ================================
# 浏览器配置
# ================================

# 浏览器引擎 (selenium, playwright)
BROWSER_ENGINE=playwright

# 是否无头模式 (true, false)
BROWSER_HEADLESS=true

# 浏览器窗口大小
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080

# 页面加载等待时间（秒）
BROWSER_WAIT_TIME=3

# 浏览器超时时间（秒）
BROWSER_TIMEOUT=30

# 用户代理字符串（可选）
# USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# 代理设置（可选）
# PROXY=http://proxy.example.com:8080

# Chrome浏览器路径（可选）
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ChromeDriver路径（可选）
# CHROME_DRIVER_PATH=C:\chromedriver\chromedriver.exe

# ================================
# OCR配置
# ================================

# OCR引擎 (auto, tesseract, easyocr, paddleocr)
OCR_ENGINE=auto

# OCR语言（逗号分隔）
OCR_LANGUAGES=eng,chi_sim

# OCR置信度阈值 (0.0-1.0)
OCR_CONFIDENCE_THRESHOLD=0.6

# 是否启用图片预处理 (true, false)
OCR_PREPROCESS=true

# Tesseract命令路径（Windows需要）
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tesseract配置参数
TESSERACT_CONFIG=--psm 1 --oem 3

# EasyOCR是否使用GPU (true, false)
EASYOCR_GPU=false

# EasyOCR模型存储目录（可选）
# EASYOCR_MODEL_DIR=~/.EasyOCR/

# PaddleOCR是否使用角度分类 (true, false)
PADDLEOCR_USE_ANGLE_CLS=true

# PaddleOCR是否使用GPU (true, false)
PADDLEOCR_USE_GPU=false

# ================================
# PDF配置
# ================================

# PDF页面大小 (A4, letter, custom)
PDF_PAGE_SIZE=A4

# PDF页边距（点）
PDF_MARGIN=50

# 是否包含OCR文本层 (true, false)
PDF_INCLUDE_OCR_TEXT=true

# 是否生成可搜索PDF (true, false)
PDF_SEARCHABLE=true

# 是否压缩图片 (true, false)
PDF_COMPRESS_IMAGES=true

# 图片质量 (1-100)
PDF_IMAGE_QUALITY=85

# PDF元数据
PDF_TITLE=网页截图合集
PDF_AUTHOR=Web Screenshot PDF Tool
PDF_SUBJECT=自动生成的网页截图PDF文档
PDF_KEYWORDS=网页截图,OCR,PDF

# ================================
# 处理配置
# ================================

# 最大并发任务数
MAX_CONCURRENT_TASKS=3

# 重试次数
RETRY_ATTEMPTS=3

# 重试延迟（秒）
RETRY_DELAY=1.0

# 截图超时时间（秒）
SCREENSHOT_TIMEOUT=30

# OCR超时时间（秒）
OCR_TIMEOUT=60

# PDF创建超时时间（秒）
PDF_CREATION_TIMEOUT=120

# 临时目录（可选）
# TEMP_DIR=/tmp/web_screenshot_pdf

# 是否清理临时文件 (true, false)
CLEANUP_TEMP_FILES=true

# 是否保留截图文件 (true, false)
KEEP_SCREENSHOTS=false

# ================================
# 日志配置
# ================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件路径（可选）
# LOG_FILE=web_screenshot_pdf.log

# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ================================
# 截图配置
# ================================

# 是否全页面截图 (true, false)
SCREENSHOT_FULL_PAGE=true

# 图片质量 (1-100)
SCREENSHOT_QUALITY=95

# 图片格式 (PNG, JPEG, WEBP)
SCREENSHOT_FORMAT=PNG

# 图片DPI
SCREENSHOT_DPI=300

# 是否启用移动端模拟 (true, false)
MOBILE_EMULATION=false

# 移动设备名称（当启用移动端模拟时）
# DEVICE_NAME=iPhone 12

# 隐藏元素的CSS选择器（逗号分隔）
HIDE_ELEMENTS=.advertisement,.popup,#cookie-banner

# ================================
# 高级配置
# ================================

# 图片缩放因子
RESIZE_FACTOR=1.0

# 是否自动裁剪 (true, false)
AUTO_CROP=false

# 裁剪边距（像素）
CROP_MARGIN=10

# 是否增强对比度 (true, false)
ENHANCE_CONTRAST=true

# 是否增强锐度 (true, false)
ENHANCE_SHARPNESS=true

# 是否降噪 (true, false)
DENOISE=true

# PDF文本层透明度 (0.0-1.0, 0.0为完全透明)
PDF_TEXT_LAYER_OPACITY=0.0

# ================================
# 开发和调试
# ================================

# 是否启用调试模式 (true, false)
DEBUG=false

# 是否显示浏览器窗口（调试用）
SHOW_BROWSER=false

# 是否保存调试信息 (true, false)
SAVE_DEBUG_INFO=false

# 调试信息保存目录
# DEBUG_DIR=./debug

# ================================
# 网络配置
# ================================

# 网络请求超时时间（秒）
NETWORK_TIMEOUT=30

# 最大重定向次数
MAX_REDIRECTS=10

# 是否验证SSL证书 (true, false)
VERIFY_SSL=true

# 自定义请求头（JSON格式）
# CUSTOM_HEADERS={"User-Agent": "Custom Bot 1.0"}

# ================================
# 性能优化
# ================================

# 是否启用图片缓存 (true, false)
ENABLE_IMAGE_CACHE=true

# 缓存目录
# CACHE_DIR=./cache

# 缓存过期时间（小时）
CACHE_EXPIRE_HOURS=24

# 最大内存使用量（MB）
MAX_MEMORY_MB=1024

# 是否启用多进程 (true, false)
ENABLE_MULTIPROCESSING=false

# 进程池大小
PROCESS_POOL_SIZE=2