[MASTER]
init-hook="import os, sys; repo_root=os.path.dirname(__file__); project_root=os.path.join(repo_root, 'MCP', 'PDF'); sys.path.insert(0, os.path.join(project_root, 'src')); sys.path.insert(0, project_root)"
jobs=0
ignore=.git,__pycache__,build,dist,examples,tests/fixtures
ignore-patterns=^\.#
load-plugins=pylint.extensions.docparams

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-branches,
    too-many-return-statements,
    too-many-statements,
    logging-fstring-interpolation

[REPORTS]
output-format=colorized
reports=no
score=yes

[TYPECHECK]
ignored-modules=
    numpy,
    cv2,
    fitz,
    pdfplumber,
    camelot,
    tabula,
    pandas,
    pytesseract,
    easyocr,
    paddleocr,
    torch,
    torchvision

[FORMAT]
max-line-length=100

[DESIGN]
max-args=10
max-attributes=15
max-locals=25

[SIMILARITIES]
min-similarity-lines=15
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes

[REFACTORING]
max-nested-blocks=5

[LOGGING]
logging-modules=logging

[VARIABLES]
additional-builtins=


