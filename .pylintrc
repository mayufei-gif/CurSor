[MASTER]
init-hook="import sys; from pathlib import Path; sys.path.insert(0, str(Path.cwd() / 'MCP/PDF/src'))"
ignore=.git,build,dist
persistent=no

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring

[REPORTS]
score=no

[DESIGN]
max-args=10
max-attributes=12
max-branches=20
max-locals=25
max-returns=10
max-statements=100

[FORMAT]
max-line-length=100

[TYPECHECK]
ignored-modules=
    fitz,
    cv2,
    camelot,
    tabula,
    pdfplumber,
    paddleocr,
    easyocr,
    pytesseract,
    pdf2image

[SIMILARITIES]
min-similarity-lines=8

